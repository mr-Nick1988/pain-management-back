# Copy this file to .env and adjust values as needed

# Postgres (monolith)
PG_AUTH_USER=postgres
PG_AUTH_PASSWORD=postgres

# Authentication service DB (host Postgres)
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/auth_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Authentication service security
JWT_SECRET=please-change-me-to-a-long-random-secret-string
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Kafka topics (optional overrides)
KAFKA_TOPIC_REPORTING_COMMANDS=reporting-commands
KAFKA_TOPIC_LOGGING_EVENTS=logging-events

# Logging service (Mongo URI; by default uses container mongo)
LOGGING_MONGODB_URI=mongodb://mongo:27017/logging_db

# Backup-restore configuration (optional)
BACKUP_DS_URL=jdbc:postgresql://postgres-main:5432/backup_service
BACKUP_DS_USER=postgres
BACKUP_DS_PASS=postgres
PG_HOST=postgres-main
PG_PORT=5432
PG_DB=pain_management_db
PG_USER=postgres
PG_PASSWORD=postgres
BACKUP_BASE_DIR=/app/backups
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULER_ENABLED=false
