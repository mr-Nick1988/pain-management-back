@startuml Pain Management - Deployment Diagram
!theme plain
title Pain Management Platform - Deployment Architecture (2026)

' ============================================================================
' DEVELOPMENT ENVIRONMENT
' ============================================================================
node "Developer Machine" as dev_machine {
  artifact "IDE\n(IntelliJ/VS Code)" as ide
  artifact "Monolith\n(mvn spring-boot:run)" as monolith_dev
}

' ============================================================================
' DOCKER CONTAINERS (Development)
' ============================================================================
node "Docker Environment\n(docker-compose.dev.yml)" as docker {
  
  ' Infrastructure
  node "Kafka Container" as kafka_node #LightSalmon {
    artifact "Apache Kafka 7.6.1\n(KRaft mode)\nPort: 9092" as kafka
  }
  
  node "PostgreSQL Container" as postgres_node #LightBlue {
    artifact "postgres:16-alpine\n~80MB\nPort: 5432" as postgres
    database "pain_management_db" as db1
    database "auth_db" as db2
    database "emr_integration_db" as db3
    database "notification_db" as db4
    database "pain_escalation_db" as db5
    database "external_vas_db" as db6
  }
  
  node "PostgreSQL Analytics" as postgres_analytics_node #LightBlue {
    artifact "postgres:16-alpine\nPort: 5433" as postgres_analytics
    database "analytics_reporting" as db_analytics
  }
  
  ' Microservices
  node "Auth Service Container" as auth_node #LightYellow {
    artifact "authentication-service\nJava 21 + Alpine\nPort: 8082" as auth_service
  }
  
  node "EMR Service Container" as emr_node #LightYellow {
    artifact "emr-integration-service\nJava 21 + Alpine\nPort: 8086" as emr_service
  }
  
  node "Notification Container" as notif_node #LightYellow {
    artifact "notification-service\nJava 21 + Alpine\nPort: 8087" as notif_service
  }
  
  node "Pain Escalation Container" as escalation_node #LightYellow {
    artifact "pain-escalation-service\nJava 21 + Alpine\nPort: 8088" as escalation_service
  }
  
  node "External VAS Container" as vas_node #LightYellow {
    artifact "external-vas-service\nJava 21 + Alpine\nPort: 8089" as vas_service
  }
  
  node "Reporting Container" as reporting_node #LightYellow {
    artifact "reporting-service\nJava 21 + Alpine\nPort: 8091" as reporting_service
  }
  
  node "Backup Container" as backup_node #LightCoral {
    artifact "backup-restore-service\nJava 21 + Alpine\nPort: 8085" as backup_service
  }
  
  ' Tools
  node "Kafdrop Container\n(Optional)" as kafdrop_node #LightGray {
    artifact "Kafdrop UI\nPort: 9000" as kafdrop
  }
}

' ============================================================================
' EXTERNAL SYSTEMS
' ============================================================================
cloud "External Services" as external {
  node "FHIR Server" as fhir {
    artifact "HAPI FHIR R4\nhttp://hapi.fhir.org" as fhir_server
  }
  
  node "Email Server" as smtp {
    artifact "SMTP Server\n(MailHog for dev)" as smtp_server
  }
  
  node "VAS Devices" as devices {
    artifact "External VAS\nMonitoring Devices" as vas_devices
  }
}

' ============================================================================
' MONITORING (STAGE 4)
' ============================================================================
node "Observability Stack\n(STAGE 4)" as monitoring #Lavender {
  node "Prometheus Container" as prom_node {
    artifact "prom/prometheus:latest\n(Alpine)\nPort: 9090" as prometheus
  }
  
  node "Grafana Container" as grafana_node {
    artifact "grafana/grafana:latest\n(Alpine)\nPort: 3000" as grafana
  }
}

' ============================================================================
' FRONTEND
' ============================================================================
node "Frontend Server\n(Vite Dev Server)" as frontend_node {
  artifact "React SPA\nPort: 5173" as react_app
}

' ============================================================================
' CONNECTIONS: Services → Infrastructure
' ============================================================================
monolith_dev --> kafka : Kafka Client\n9092
monolith_dev --> postgres : JDBC\n5432

auth_service --> postgres : JDBC\n(auth_db)
auth_service --> kafka : Kafka Client

emr_service --> postgres : JDBC\n(emr_integration_db)
emr_service --> kafka : Kafka Client
emr_service --> fhir_server : FHIR R4 HTTP

notif_service --> postgres : JDBC\n(notification_db)
notif_service --> kafka : Kafka Consumer
notif_service --> smtp_server : SMTP

escalation_service --> postgres : JDBC\n(pain_escalation_db)
escalation_service --> kafka : Kafka

vas_service --> postgres : JDBC\n(external_vas_db)
vas_service --> kafka : Kafka
vas_service <-- vas_devices : HTTP POST\nJSON/XML/CSV

reporting_service --> postgres_analytics : JDBC
reporting_service --> kafka : Kafka Consumer

backup_service --> postgres : pg_dump/restore
backup_service --> postgres_analytics : pg_dump/restore

' ============================================================================
' CONNECTIONS: Monitoring
' ============================================================================
monolith_dev ..> prometheus : /actuator/prometheus
auth_service ..> prometheus : metrics
emr_service ..> prometheus : metrics
notif_service ..> prometheus : metrics
escalation_service ..> prometheus : metrics
vas_service ..> prometheus : metrics
reporting_service ..> prometheus : metrics

prometheus --> grafana : Data Source

' ============================================================================
' CONNECTIONS: Frontend → Backend
' ============================================================================
react_app --> monolith_dev : REST API\nHTTP
react_app --> auth_service : Authentication
react_app --> notif_service : WebSocket

' ============================================================================
' CONNECTIONS: Tools
' ============================================================================
kafdrop --> kafka : Monitor Topics

' ============================================================================
' NOTES
' ============================================================================
note right of docker
  **Docker Compose Profiles**
  
  docker-compose up
  → Infrastructure only
  
  docker-compose --profile all up
  → Everything
  
  docker-compose --profile core up
  → Critical services
  
  docker-compose --profile tools up
  → With Kafdrop
end note

note right of postgres
  **Lightweight Images**
  
  postgres:16-alpine
  → ~80MB (vs ~150MB standard)
  
  Multi-stage builds for services
  → ~150MB per service
  
  Total stack: ~1.5GB
  (vs ~3GB with standard images)
end note

note bottom of monitoring
  **STAGE 4: Observability**
  
  Prometheus scrapes metrics every 15s
  Grafana provides dashboards
  Spring Boot Actuator exposes metrics
  Micrometer registry for custom metrics
end note

note left of external
  **External Systems**
  
  FHIR Server: EMR data sync
  SMTP: Email notifications
  VAS Devices: Real-time pain data
  
  All via secure HTTP/HTTPS
end note

@enduml
