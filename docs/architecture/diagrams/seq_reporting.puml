@startuml
' Reporting: current internal vs planned microservice
skinparam monochrome true

actor User
participant "ReportStatisticsController (monolith)" as RC
participant "DataAggregationService (monolith)" as DAS
database "Postgres Main" as PG

== Current (in-monolith) ==
User -> RC : GET /api/reports/* (monolith)
RC -> DAS : aggregate(period)
DAS -> PG : SQL reads
PG --> DAS : data
DAS --> RC : aggregates
RC --> User : JSON or files (Excel/PDF)

== Planned (microservice) ==
participant "Kafka Producer (monolith)" as KP
queue "Kafka: reporting-commands" as K
participant "Reporting-Service" as RS

User -> RS : REST /api/reports/* (direct or via gateway)
' Optionally: monolith triggers generation by Kafka command
KP -> K : ReportingCommand {action,date,...}
K -> RS : consume
RS -> PG : write/read reports (analytics DB)
RS --> User : JSON/exports/email
@enduml
