@startuml Pain Management - Kafka Event Flow
!theme plain
title Pain Management Platform - Kafka Event Flow (2026)

' ============================================================================
' PARTICIPANTS
' ============================================================================
participant "Monolith\n(8080)" as monolith
participant "EMR Service\n(8086)" as emr
participant "Pain Escalation\n(8088)" as escalation
participant "External VAS\n(8089)" as vas_service
participant "Kafka\nBroker" as kafka
participant "Notification\n(8087)" as notification
participant "Reporting\n(8091)" as reporting

' ============================================================================
' SCENARIO 1: Patient Registration (Monolith → Analytics)
' ============================================================================
group Patient Registration Event
  monolith -> kafka : Publish to **analytics-events**\n{\n  eventType: "PATIENT_REGISTERED"\n  mrn: "MRN-12345"\n  age: 45\n  gender: "MALE"\n}
  kafka -> reporting : Consume analytics-events
  reporting -> reporting : Store patient\nstatistics
end

' ============================================================================
' SCENARIO 2: VAS Recording → Pain Escalation Detection
' ============================================================================
group VAS Recording & Auto-Escalation
  monolith -> kafka : Publish to **analytics-events**\n{\n  eventType: "VAS_RECORDED"\n  mrn: "MRN-12345"\n  vasLevel: 8\n  location: "Ward A"\n}
  
  escalation -> kafka : Consume vas.recorded\n(if subscribed)
  escalation -> escalation : Detect escalation:\nVAS increase ≥ 2 points
  
  escalation -> kafka : Publish to **pain.escalated**\n{\n  escalationId: 123\n  mrn: "MRN-12345"\n  previousVas: 5\n  currentVas: 8\n  priority: "HIGH"\n}
  
  kafka -> notification : Consume pain.escalated
  notification -> notification : Send email to\nAnesthesiologist
  notification -> notification : Send WebSocket alert\nto Frontend
end

' ============================================================================
' SCENARIO 3: External VAS Device → Integration
' ============================================================================
group External VAS Device Integration
  participant "VAS Device" as device
  
  device -> vas_service : POST /api/external/vas/record\nX-API-Key: xxx\n{\n  patientMrn: "MRN-67890"\n  vasLevel: 7\n  deviceId: "MONITOR-001"\n  format: "JSON"\n}
  
  vas_service -> vas_service : Validate API key\nParse JSON/XML/CSV
  
  vas_service -> kafka : Publish to **vas.external.recorded**\n{\n  vasRecordId: 456\n  mrn: "MRN-67890"\n  vasLevel: 7\n  deviceId: "MONITOR-001"\n  autoRecommendationTriggered: true\n}
  
  kafka -> escalation : Consume vas.external.recorded
  escalation -> escalation : Track VAS trend\nCheck for escalation
end

' ============================================================================
' SCENARIO 4: EMR Changes from External System
' ============================================================================
group EMR Synchronization
  participant "FHIR Server" as fhir
  
  fhir -> emr : GET /Patient/{id}\n(FHIR R4 request)
  emr -> emr : Fetch patient data\nfrom FHIR
  
  emr -> kafka : Publish to **emr.changes**\n{\n  mrn: "MRN-12345"\n  changeType: "LAB_RESULT_UPDATED"\n  gfrValue: 45\n  timestamp: "2026-01-09T10:00:00Z"\n}
  
  kafka -> monolith : Consume emr.changes\n(optional)
  monolith -> monolith : Update internal\nEMR cache
  
  kafka -> reporting : Consume emr.changes
  reporting -> reporting : Update EMR\nstatistics
end

' ============================================================================
' SCENARIO 5: Dose Administration Event
' ============================================================================
group Dose Administration
  escalation -> kafka : Publish to **dose.administered**\n{\n  doseId: 789\n  mrn: "MRN-12345"\n  medication: "Morphine"\n  dosage: "5mg"\n  administeredBy: "nurse_001"\n}
  
  kafka -> notification : Consume dose.administered
  notification -> notification : Send confirmation\nnotification
  
  kafka -> reporting : Consume for analytics
  reporting -> reporting : Track medication\nusage statistics
end

' ============================================================================
' SCENARIO 6: Reporting Command
' ============================================================================
group Report Generation
  monolith -> kafka : Publish to **reporting-commands**\n{\n  commandType: "GENERATE_MONTHLY_REPORT"\n  month: "2025-12"\n  requestedBy: "doctor_001"\n}
  
  kafka -> reporting : Consume reporting-commands
  reporting -> reporting : Generate report\nfrom aggregated data
  reporting -> notification : Request to send report\nvia email
  notification -> notification : Send PDF report\nto doctor
end

' ============================================================================
' NOTES
' ============================================================================
note over kafka
  **Kafka Topics**
  
  Published by Monolith:
  - analytics-events (patient, vas, emr, recommendation)
  - emr.created
  - reporting-commands
  
  Published by Microservices:
  - emr.changes (EMR Service)
  - pain.escalated (Pain Escalation)
  - dose.administered (Pain Escalation)
  - vas.recorded (Pain Escalation)
  - vas.external.recorded (External VAS)
end note

note over notification
  **Notification Service**
  Consumes multiple topics:
  - pain.escalated
  - dose.administered
  - vas.recorded (optional)
  
  Sends notifications via:
  - Email (SMTP)
  - WebSocket (real-time)
  - Push (future)
end note

@enduml
