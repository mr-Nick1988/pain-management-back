@startuml
' Current Integration Context (2026-01-23)
skinparam monochrome true
skinparam componentStyle rectangle

actor User
component "API Gateway\n(8000)" as GATEWAY
component "Monolith\n(8080)" as Monolith
queue "Kafka" as Kafka
storage "PostgreSQL Main\n(5432)" as PG
storage "PostgreSQL Analytics\n(5433)" as PG_ANALYTICS
component "HAPI FHIR Server\n(external)" as FHIR
component "Authentication Service\n(8082)" as AUTH
component "EMR Service\n(8086)" as EMR
component "Notification Service\n(8087)" as NOTIF
component "Pain Escalation\n(8088)" as ESCALATION
component "External VAS\n(8089)" as VAS
component "Reporting Service\n(8091)" as REPORT
component "Backup\n(8085)" as BACKUP

User --> GATEWAY : HTTP/REST (Single Entry Point)
GATEWAY --> Monolith : /api/patients, /api/vas, etc
GATEWAY --> AUTH : /api/auth
GATEWAY --> EMR : /api/emr, /api/fhir
GATEWAY --> NOTIF : /api/notifications
GATEWAY --> ESCALATION : /api/escalations
GATEWAY --> VAS : /api/external-vas
GATEWAY --> REPORT : /api/reports
GATEWAY --> BACKUP : /api/backup

Monolith --> PG : JPA/Hibernate
AUTH --> PG
EMR --> PG
NOTIF --> PG
ESCALATION --> PG
VAS --> PG
BACKUP --> PG

REPORT --> PG_ANALYTICS

Monolith --> Kafka : analytics-events (producer)
EMR --> Kafka : emr.changes, emr.created (producer)
ESCALATION --> Kafka : pain.escalated (producer)
REPORT <-- Kafka : reporting-commands (consumer)
NOTIF <-- Kafka : pain.escalated (consumer)

EMR --> FHIR : HAPI FHIR (HTTP)
@enduml
