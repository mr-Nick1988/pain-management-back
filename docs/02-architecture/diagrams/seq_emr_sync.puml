@startuml
' EMR Scheduled Sync (HTTP FHIR)
skinparam monochrome true

actor Scheduler
participant "EmrSyncScheduler" as S
participant "HapiFhirClient" as H
participant "EmrChangeDetectionService" as D
database "EmrRepository" as R
participant "EmrRecalculationService" as C
participant "WebSocketNotificationService" as W

Scheduler -> S : cron 0 0 */6 * * *
S -> H : fetch Patient/Observations
H --> S : FHIR resources (Patient, Observation)
S -> D : detect changes
D -> R : load/update EMR
R --> D : saved
D -> C : handleCriticalEmrChanges(...)
C -> W : notify clients
@enduml
