@startuml Pain Management - Microservices Architecture 2026
!theme plain
skinparam backgroundColor #FEFEFE
skinparam componentStyle rectangle

title Pain Management Platform - Microservices Architecture (2026-01-24)

' ============================================================================
' FRONTEND LAYER
' ============================================================================
package "Frontend Layer" as frontend #LightBlue {
  [React SPA\n(port 5173)] as react
}

' ============================================================================
' API GATEWAY LAYER (Implemented)
' ============================================================================
package "Gateway Layer" as gateway #LightGreen {
  [API Gateway\n(Spring Cloud Gateway)\n(port 8000)] as api_gateway {
    component "JWT Validation" as jwt
    component "Circuit Breaker" as cb
    component "Request Routing" as routing
    component "CORS" as cors
  }
}

' ============================================================================
' MONOLITH + MICROSERVICES
' ============================================================================
package "Application Layer" as app_layer {
  
  ' Монолит
  package "Monolith" #LightGreen {
    [Pain Management\nMonolith\n(port 8080)] as monolith {
      component "Admin Module" as admin
      component "Doctor Module" as doctor
      component "Nurse Module" as nurse
      component "Anesthesiologist" as anesth
      component "Treatment Protocols" as protocols
      component "Common Entities" as entities
    }
  }
  
  ' Микросервисы
  package "Microservices" #LightYellow {
    [Authentication\nService\n(port 8082)] as auth
    [EMR Integration\nService\n(port 8086)] as emr
    [Notification\nService\n(port 8087)] as notif
    [Pain Escalation\nService\n(port 8088)] as escalation
    [External VAS\nService\n(port 8089)] as vas
    [Reporting\nService\n(port 8091)] as reporting
  }
  
  ' Операционные сервисы
  package "Operations" #LightCoral {
    [Backup & Restore\nService\n(port 8085)] as backup
  }
}

' ============================================================================
' EVENT STREAMING LAYER
' ============================================================================
package "Event Streaming" as streaming #LightSalmon {
  queue "Apache Kafka\n(port 9092)" as kafka {
    queue "analytics-events" as topic_analytics
    queue "emr.changes" as topic_emr_changes
    queue "emr.created" as topic_emr_created
    queue "pain.escalated" as topic_pain
    queue "dose.administered" as topic_dose
    queue "vas.recorded" as topic_vas
    queue "vas.external.recorded" as topic_vas_ext
    queue "reporting-commands" as topic_reporting
  }
}

' ============================================================================
' DATA LAYER
' ============================================================================
package "Data Layer" as data_layer {
  database "PostgreSQL\nmain\n(port 5432)" as postgres {
    storage "pain_management_db" as db_main
    storage "auth_db" as db_auth
    storage "emr_integration_db" as db_emr
    storage "notification_db" as db_notif
    storage "pain_escalation_db" as db_escalation
    storage "external_vas_db" as db_vas
    storage "backup_service" as db_backup
  }
  
  database "PostgreSQL\nAnalytics\n(port 5433)" as postgres_analytics {
    storage "analytics_reporting" as db_analytics
  }
}

' ============================================================================
' EXTERNAL SYSTEMS
' ============================================================================
package "External Systems" as external #LightGray {
  [FHIR Server\n(HAPI FHIR)] as fhir
  [Email Server\n(SMTP)] as smtp
  [External VAS\nDevices] as vas_devices
}

' ============================================================================
' SERVICE DISCOVERY & OBSERVABILITY
' ============================================================================
package "Service Discovery" as service_discovery #LightCyan {
  [Consul\n(port 8500, 8600)] as consul {
    component "Service Registry" as registry
    component "Health Checks" as health
    component "DNS Interface" as dns
  }
}

package "Observability" as observability #Lavender {
  [Jaeger\n(port 16686, 4318)] as jaeger {
    component "Trace Collector" as collector
    component "Trace UI" as trace_ui
  }
  [Prometheus\n(port 9090)] as prometheus
  [Grafana\n(port 3000)] as grafana
}

' ============================================================================
' CONNECTIONS: Frontend → API Gateway → Services
' ============================================================================
react --> api_gateway : "HTTPS/REST\n(Single Entry Point)"

' API Gateway routes to all services
api_gateway --> monolith : "/api/patients/**\n/api/vas/**\netc"
api_gateway --> auth : "/api/auth/**"
api_gateway --> emr : "/api/emr/**\n/api/fhir/**"
api_gateway --> notif : "/api/notifications/**"
api_gateway --> escalation : "/api/escalations/**"
api_gateway --> vas : "/api/external-vas/**"
api_gateway --> reporting : "/api/reports/**"
api_gateway --> backup : "/api/backup/**"

' ============================================================================
' CONNECTIONS: Monolith → Microservices (Internal)
' ============================================================================
monolith ..> notif : Internal calls

' ============================================================================
' CONNECTIONS: Microservices → Kafka (Publish)
' ============================================================================
monolith --> topic_analytics : Publish\nevents
monolith --> topic_emr_created : Publish
emr --> topic_emr_changes : Publish
emr --> topic_emr_created : Publish
escalation --> topic_pain : Publish
escalation --> topic_dose : Publish
escalation --> topic_vas : Publish
vas --> topic_vas_ext : Publish

' ============================================================================
' CONNECTIONS: Microservices → Kafka (Consume)
' ============================================================================
notif <-- topic_pain : Subscribe
notif <-- topic_dose : Subscribe
notif <-- topic_vas : Subscribe
reporting <-- topic_reporting : Subscribe
escalation <-- topic_vas : Subscribe

' ============================================================================
' CONNECTIONS: Services → Databases
' ============================================================================
monolith --> db_main
auth --> db_auth
emr --> db_emr
notif --> db_notif
escalation --> db_escalation
vas --> db_vas
backup --> db_backup
reporting --> db_analytics

' ============================================================================
' CONNECTIONS: External Systems
' ============================================================================
emr --> fhir : FHIR R4\nHTTP
notif --> smtp : SMTP
vas <-- vas_devices : JSON/XML/CSV\nHTTP POST

' ============================================================================
' CONNECTIONS: Backup Operations
' ============================================================================
backup ..> postgres : pg_dump/\npg_restore
backup ..> postgres_analytics : pg_dump/\npg_restore

' ============================================================================
' CONNECTIONS: Service Discovery (Consul)
' ============================================================================
api_gateway ..> consul : Register +\nQuery services
auth ..> consul : Register +\nHealth checks
emr ..> consul : Register
notif ..> consul : Register
escalation ..> consul : Register
vas ..> consul : Register
reporting ..> consul : Register
backup ..> consul : Register

' ============================================================================
' CONNECTIONS: Distributed Tracing (Jaeger)
' ============================================================================
api_gateway ..> jaeger : Send traces\n(OTLP HTTP)
auth ..> jaeger : Traces
emr ..> jaeger : Traces
notif ..> jaeger : Traces
escalation ..> jaeger : Traces
vas ..> jaeger : Traces
reporting ..> jaeger : Traces
backup ..> jaeger : Traces

' ============================================================================
' CONNECTIONS: Monitoring (Prometheus + Grafana)
' ============================================================================
monolith ..> prometheus : /actuator/\nprometheus
auth ..> prometheus : metrics
emr ..> prometheus : metrics
notif ..> prometheus : metrics
escalation ..> prometheus : metrics
vas ..> prometheus : metrics
reporting ..> prometheus : metrics
prometheus --> grafana : Data source

' ============================================================================
' NOTES
' ============================================================================
note right of monolith
  **Core Business Logic**
  - Patient management
  - Treatment protocols
  - User roles (admin, doctor, nurse, anesthesiologist)
  - VAS internal recording
  - EMR internal storage
end note

note right of kafka
  **Event-Driven Architecture**
  - Asynchronous communication
  - Event sourcing
  - CQRS pattern
  - Loose coupling
end note

note bottom of postgres
  **Single PostgreSQL Instance**
  - Multiple databases for isolation
  - Shared for dev (separate in prod)
  - NO MongoDB anymore!
end note

note right of service_discovery
  **Service Discovery (Phase 3) ✅**
  - HashiCorp Consul 1.17
  - Auto service registration
  - Health checks every 10s
  - Load balancing (Round Robin)
  - Dynamic routing: lb://service-name
end note

note right of observability
  **Observability Stack**
  - **Jaeger (Phase 7) ✅**: Distributed tracing
  - **Prometheus**: Metrics collection
  - **Grafana**: Visualization
  - Spring Boot Actuator
  - Micrometer + OpenTelemetry
end note

@enduml
