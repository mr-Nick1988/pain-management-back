# ============================================================================
# Development Environment Variables - Pain Management Platform
# ============================================================================
# ИНСТРУКЦИЯ: Скопируй это в .env файл (если его нет)
# ============================================================================

# PostgreSQL (Main - Docker container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# PostgreSQL Analytics (Docker container)
POSTGRES_ANALYTICS_USER=analytics
POSTGRES_ANALYTICS_PASSWORD=analytics

# Authentication Service (host Postgres)
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=postgres

# JWT Secret (ВАЖНО: должен быть одинаковым в монолите и auth-service!)
JWT_SECRET=pain-management-secret-key-change-in-production-min-256-bits-required-for-hs256-algorithm-security
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept,Origin,X-Requested-With
CORS_ALLOW_CREDENTIALS=true

# Kafka Topics
KAFKA_TOPIC_REPORTING_COMMANDS=reporting-commands
KAFKA_TOPICS_REPORTING_COMMANDS=reporting-commands
KAFKA_TOPIC_LOGGING_EVENTS=logging-events

# Email (для dev - используй MailHog или оставь пустым)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# FHIR Server (external)
FHIR_SERVER_URL=http://hapi.fhir.org/baseR4
EMR_SYNC_ENABLED=false

# Backup Settings
BACKUP_SCHEDULER_ENABLED=false
BACKUP_RETENTION_DAYS=30

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
