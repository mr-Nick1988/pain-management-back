<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001-remove-password-from-person" author="cascade">
        <comment>
            Удаление поля password из таблицы person в рамках миграции на Authentication Service.
            После этой миграции аутентификация будет выполняться через отдельный микросервис.
        </comment>

        <!-- Проверяем, существует ли колонка password перед удалением -->
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="person" columnName="password"/>
        </preConditions>

        <!-- Удаляем колонку password -->
        <dropColumn tableName="person" columnName="password"/>

        <rollback>
            <!-- Rollback: добавляем колонку обратно (данные будут потеряны!) -->
            <addColumn tableName="person">
                <column name="password" type="VARCHAR(255)">
                    <constraints nullable="true"/>
                </column>
            </addColumn>
        </rollback>
    </changeSet>

</databaseChangeLog>
